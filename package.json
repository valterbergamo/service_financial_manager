{
  "name": "financial-backend",
  "version": "1.0.0",
  "description": "Backend CAP para gerenciador financeiro pessoal",
  "private": true,
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4",
    "@cap-js/postgres": "^2.3.0",
    "@sap/xssec": "^4",
    "cors": "^2.8.6"
  },
  "devDependencies": {},
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy --to postgres"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres"
      },
      "auth": "dummy"
    },
    "[development]": {
      "cors": {
        "origin": "*"
      }
    }
  }
}
